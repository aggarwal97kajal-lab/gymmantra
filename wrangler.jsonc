// Cloudflare Worker: runs the GymMantra API and serves the admin panel and
// exercise videos. Settings (FIREBASE_API_KEY, FIREBASE_PROJECT_ID,
// SERVER_PASSWORD, SUPER_ADMIN_EMAIL) are added in the Cloudflare dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gymmantra",
  "main": "apps/worker/src/worker.ts",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "apps/worker/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // Keep the settings typed in the Cloudflare dashboard when deploying.
  "keep_vars": true,
  "observability": { "enabled": true },
  // Run the Worker in the Cloudflare data centre next to the database (Firestore, Mumbai). Users reach it in one hop; every database call is then ~10 ms instead of 1–2 s.
  "placement": { "region": "gcp:asia-south1" },
  // Shared memory for all Worker instances (database sign-in, secrets). Created automatically on deploy.
  "kv_namespaces": [{ "binding": "GM_KV" }],
  // Every minute: finishes sending phone notifications to large groups (lib/push.ts).
  "triggers": { "crons": ["* * * * *"] }
}
