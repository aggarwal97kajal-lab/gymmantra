// Cloudflare Worker: runs the GymMantra API and serves the admin panel and
// exercise videos. Settings (FIREBASE_API_KEY, FIREBASE_PROJECT_ID,
// SERVER_PASSWORD, SUPER_ADMIN_EMAIL) are added in the Cloudflare dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gymmantra",
  "main": "apps/worker/src/worker.ts",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "apps/worker/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // Keep the settings typed in the Cloudflare dashboard when deploying.
  "keep_vars": true,
  "observability": { "enabled": true }
}
