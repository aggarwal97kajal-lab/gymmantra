// Cloudflare Worker: runs the GymMantra API and serves the admin panel and
// exercise videos. Settings (FIREBASE_API_KEY, FIREBASE_PROJECT_ID,
// SERVER_PASSWORD, SUPER_ADMIN_EMAIL) are added in the Cloudflare dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gymmantra",
  "main": "apps/worker/src/worker.ts",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "apps/worker/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // Keep the settings typed in the Cloudflare dashboard when deploying.
  "keep_vars": true,
  "observability": { "enabled": true },
  // Cloudflare runs the Worker where it is fastest for the database (D1, Asia Pacific).
  "placement": { "mode": "smart" },
  // The database: Cloudflare D1 "gymmantra-db" (Asia Pacific). DB_BACKEND "d1" = use it; anything else = Firestore.
  "d1_databases": [{ "binding": "GM_DB", "database_name": "gymmantra-db", "database_id": "58115bdb-ef4e-4020-a44f-a5146a47071e" }],
  "vars": { "DB_BACKEND": "d1" },
  // Shared memory for all Worker instances (database sign-in, secrets). Created automatically on deploy.
  "kv_namespaces": [{ "binding": "GM_KV" }],
  // Every minute: finishes sending phone notifications to large groups (lib/push.ts).
  "triggers": { "crons": ["* * * * *"] }
}
