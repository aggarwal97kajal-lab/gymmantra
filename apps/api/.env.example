# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgresql://gymmantra:gymmantra@localhost:5432/gymmantra
JWT_SECRET=change-me-to-a-long-random-string
QR_SECRET=change-me-to-another-long-random-string
# Google sign-in (optional). OAuth client ID(s) from Google Cloud, comma separated (web, android).
GOOGLE_CLIENT_IDS=
# Email of the GymMantra super admin. This account gets super admin rights when it signs up.
SUPER_ADMIN_EMAIL=
# Admin panel URL, for CORS
ADMIN_ORIGIN=http://localhost:3001
PORT=4000
NODE_ENV=development
